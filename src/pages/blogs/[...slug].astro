---
// One page per published Latvian article at /blogs/<YYYY-MM-DD>/<uri-title>.
// A catch-all param holds both segments; the date comes from frontmatter and the
// slug is the url-title, so the route is rebuilt from the entry's data - the
// filename is irrelevant. English articles live at /en/blog/... (same shape).
import BlogPostPage from "../../components/pages/BlogPostPage.astro";
import { postsFor } from "../../i18n/posts";
import { toIsoDate } from "../../utils/date";

export async function getStaticPaths() {
  const posts = await postsFor("lv");
  return posts.map((post) => ({
    params: { slug: `${toIsoDate(post.data.date)}/${post.data.slug}` },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BlogPostPage lang="lv" post={post} />
