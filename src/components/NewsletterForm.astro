---
import { DEFAULT_LOCALE, type Locale } from "../i18n";
import { useTranslations } from "../i18n/ui";
import NewsletterLanguageNotice from "./NewsletterLanguageNotice.astro";
import NewsletterSignup from "./NewsletterSignup.astro";

interface Props {
  lang: Locale;
  description?: string;
  showBorder?: boolean;
  // When true, render the fuller unsubscribe explanation
  // (`newsletter.unsubscribeInfo`). Used only on the newsletter page, not the
  // header pop-up, which stays compact with just `unsubscribeNote`.
  showUnsubscribeInfo?: boolean;
}

const { lang, showBorder = false, showUnsubscribeInfo = false } = Astro.props;

const t = useTranslations(lang);
const description = Astro.props.description ?? t("newsletter.formDescription");
---

{
  lang !== DEFAULT_LOCALE ? (
    <section class={`newsletter-form-section ${showBorder ? "border-top" : ""}`}>
      <NewsletterLanguageNotice lang={lang} />
    </section>
  ) : (
    <NewsletterSignup
      lang={lang}
      description={description}
      showBorder={showBorder}
      showUnsubscribeInfo={showUnsubscribeInfo}
    />
  )
}
