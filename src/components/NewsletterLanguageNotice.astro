---
import { DEFAULT_LOCALE, type Locale } from "../i18n";
import { useTranslations } from "../i18n/ui";
import { site } from "../site.config";

interface Props {
  lang: Locale;
  className?: string;
}

const { lang, className } = Astro.props;
const t = useTranslations(lang);
const substackHref = site.socials.find((social) => social.label === "Substack")?.href;
---

{
  lang !== DEFAULT_LOCALE && substackHref && (
    <p class={className}>
      {t("newsletter.substackNotice.before")}<br>
      {t("newsletter.substackNotice.before2")}
      <a href={substackHref} target="_blank" rel="noopener">
        {t("newsletter.substackNotice.linkText")}
      </a>
      {t("newsletter.substackNotice.after")}
    </p>
  )
}
