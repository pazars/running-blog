---
import { site } from "../site.config";
import { gravatarUrl } from "../utils/avatar";
import { DEFAULT_LOCALE, homePath, type Locale } from "../i18n";
import { navLinks, type ActivePage } from "../i18n/routes";
import { useTranslations } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import NewsletterLanguageNotice from "./NewsletterLanguageNotice.astro";
import NewsletterSignup from "./NewsletterSignup.astro";

// Site-wide profile image from the Gravatar account (see src/utils/avatar.ts).
const gravatarAvatar = gravatarUrl(160);
// Larger render shown when the avatar is hovered (desktop) or tapped (mobile).
const gravatarAvatarLarge = gravatarUrl(480);

interface Props {
  lang: Locale;
  avatarUrl?: string;
  activePage?: ActivePage;
  /**
   * Where the LV/EN pill should point for this page. Falls back to each locale's
   * home page, so an untranslated article never links to a 404.
   */
  langHrefs?: Partial<Record<Locale, string>>;
}

const {
  lang,
  avatarUrl = gravatarAvatar,
  activePage = "blog",
  langHrefs,
} = Astro.props;

const t = useTranslations(lang);
// `name` and `role` used to be props repeated at all ten call sites; they are
// derived here now - the name is locale-invariant, the role is a dictionary key.
const name = site.name;
const role = t("site.role");
const nav = navLinks(lang);
---

<header class="mb-4">
  <div class="brand d-flex flex-items-center">
    <div class="wrapper d-flex flex-items-center" data-js-avatar-zoom>
      <button
        type="button"
        class="image-container mr-3"
        aria-label={t("header.avatarZoomLabel")}
        data-js-avatar-trigger
      >
        <img
          src={avatarUrl}
          alt={t("header.avatarAlt")}
          class="image"
          width="80"
          height="80"
        />
      </button>
      {/* Must stay locale-scoped: a bare "/" would re-enter language
          negotiation and could bounce the reader into the other language. */}
      <a href={homePath(lang)} class="info">
        <div class="title">{name}</div>
        <div class="desc color-fg-muted">{role}</div>
      </a>
      <div class="avatar-zoom-preview" data-js-avatar-preview>
        <img
          src={gravatarAvatarLarge}
          alt={t("header.avatarLargeAlt")}
          class="avatar-zoom-img"
          width="240"
          height="240"
        />
      </div>
    </div>
  </div>
  <div class="links d-flex flex-items-center flex-justify-end gap-1">
    <label
      class="toggle-nav d-flex flex-items-center flex-justify-end gap-1"
      data-js-toggle-nav-container
    >
      <input type="checkbox" class="input d-none" data-js-nav-input />
      <button
        aria-label={t("header.openMenu")}
        class="navButton flex-0 btn-icon btn-invisible"
        data-js-nav-button
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="content icon d-flex"
          data-js-menu-collapsed="true"
        >
          <path d="M4 5h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 19h16"></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="content icon d-none"
          data-js-menu-expanded="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
      <div class="menu">
        <nav class="d-flex flex-items-center gap-1">
          {
            nav.map((link) => (
              <a
                href={link.href}
                class={`link ${activePage === link.id ? "active" : ""}`}
              >
                {/* Template-literal key: adding an id to NAV_IDS won't compile
                    until `nav.<id>` exists in BOTH dictionaries. */}
                {/* Horizontal padding lives in the `nav > .link > .item` CSS
                    (not a px-* utility) so the narrow-screen query in
                    global.css can tighten it - utilities are !important. */}
                <div class="item">{t(`nav.${link.id}`)}</div>
              </a>
            ))
          }
        </nav>
        {/* Sibling of <nav>, NOT a fourth nav child: the mobile open animation
            in global.css staggers `nav > .link:nth-child(1..3)` by hand, so a
            fourth child would fall outside the stagger (the switcher has its
            own cascade rule instead). Inside the open mobile menu it shares
            the single row; under 400px it collapses to just the
            other-language cell (see global.css) so the row never wraps. */}
        <LanguageSwitcher lang={lang} hrefs={langHrefs} />
      </div>
    </label>
    <div class="line" data-js-line>
      <div class="divider-line pl-2 mr-2"></div>
    </div>
    <div class="contact" data-js-contact>
      <div class="dropdown-container">
        <div class="trigger tooltip-container" data-js-dropdown-trigger>
          <div class="tooltip-container" data-js-tooltip-container>
            <button class="btn-icon btn-invisible tooltip-button">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="content icon"
              >
                <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              </svg>
            </button>
            <span
              class="tooltip"
              data-position="bottom"
              data-visible="false"
              data-js-tooltip-text>{t("header.newsletterTooltip")}</span
            >
          </div>
        </div>
        <div class="panel subscribe-panel" data-js-dropdown-panel>
          {
            lang !== DEFAULT_LOCALE ? (
              <div class="subscribe-popup">
                <NewsletterLanguageNotice lang={lang} />
              </div>
            ) : (
              <NewsletterSignup
                lang={lang}
                variant="popup"
                description={t("header.newsletterBlurb")}
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Toggle the enlarged avatar on tap (mobile, where there's no hover).
  // Desktop relies on CSS :hover; the click toggle is harmless there too.
  document
    .querySelectorAll<HTMLElement>("[data-js-avatar-zoom]")
    .forEach((zoom) => {
      const trigger = zoom.querySelector("[data-js-avatar-trigger]");
      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        zoom.classList.toggle("is-open");
      });
    });

  // Tapping anywhere else closes any open preview.
  document.addEventListener("click", () => {
    document
      .querySelectorAll("[data-js-avatar-zoom].is-open")
      .forEach((zoom) => zoom.classList.remove("is-open"));
  });
</script>

<style>
  /* The avatar acts as a button; strip the native button chrome. */
  .image-container[data-js-avatar-trigger] {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .avatar-zoom-preview {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 1200;
    padding: 6px;
    background: var(--bgColor-default, #ffffff);
    border: 1px solid var(--borderColor-default, #d1d9e0);
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }

  .avatar-zoom-img {
    display: block;
    width: 200px;
    height: 200px;
    max-width: 60vw;
    border-radius: 10px;
  }

  /* Tap-to-open state (used on touch devices). */
  .wrapper.is-open .avatar-zoom-preview {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Hover-to-open on devices that support hovering. */
  @media (hover: hover) {
    [data-js-avatar-trigger]:hover ~ .avatar-zoom-preview,
    .avatar-zoom-preview:hover {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }
</style>
