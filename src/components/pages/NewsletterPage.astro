---
// Shared body of the newsletter sign-up page (/vestkopa, /en/newsletter).
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import NewsletterForm from "../NewsletterForm.astro";
import Footer from "../Footer.astro";
import type { Locale } from "../../i18n";
import { sectionAlternates } from "../../i18n/routes";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = sectionAlternates("newsletter");
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={t("newsletter.pageTitle")}
  description={t("newsletter.pageDescription")}
>
  <Header lang={lang} activePage="none" langHrefs={alternates} />

  <main>
    <section class="section-hero -no-eyebrow">
      <h1>{t("newsletter.pageHeading")}</h1>
    </section>

    <NewsletterForm lang={lang} showUnsubscribeInfo={true} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
