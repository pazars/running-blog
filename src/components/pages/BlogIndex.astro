---
// Shared body of the blog listing (/blogs, /en/blog).
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import FeaturedPost from "../FeaturedPost.astro";
import Footer from "../Footer.astro";
import { toIsoDate, formatPostDate } from "../../utils/date";
import { cardThumbnail } from "../../utils/postImages";
import type { Locale } from "../../i18n";
import { postPath, sectionAlternates } from "../../i18n/routes";
import { useTranslations } from "../../i18n/ui";
import { compare } from "../../i18n/collate";
import { tagLabel } from "../../i18n/tags";
import { postsFor } from "../../i18n/posts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = sectionAlternates("blog");

// Newest first (postsFor sorts, so the listing, home page and feed can't drift).
// Each card carries its metadata in data-* attributes so the scoped script below
// can filter/sort entirely on the client (no fetch).
const posts = await postsFor(lang);

// Optimize each local thumbnail to a card-sized WebP up front (the JSX map
// below can't be async); keyed by entry id for lookup while rendering.
const thumbnails = new Map(
  await Promise.all(
    posts.map(async (p) => [p.id, await cardThumbnail(p.data.thumbnail)] as const),
  ),
);

// Chips sort by their DISPLAYED label (tags are canonical slugs, shown via
// tagLabel), so the order stays alphabetical in the reader's language.
const byLabel = compare(lang);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) =>
  byLabel(tagLabel(lang, a), tagLabel(lang, b)),
);
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={t("blog.title")}
  description={t("blog.description")}
>
  <Header lang={lang} activePage="blog" langHrefs={alternates} />

  <main>
    <section class="section-hero -no-eyebrow">
      <!-- Filters: tag chips (multi-select, AND) + date sort -->
      <div class="blog-filters" data-js-blog-filters>
        <div class="blog-chips" data-js-tag-filter aria-label={t("blog.filterByTopic")}>
          <button type="button" class="btn btn-secondary blog-chip active" data-tag="" aria-pressed="true">
            {t("blog.allTopics")}
          </button>
          {
            allTags.map((tag) => (
              <button
                type="button"
                class="btn btn-invisible blog-chip"
                data-tag={tag}
                aria-pressed="false"
              >
                {tagLabel(lang, tag)}
              </button>
            ))
          }
        </div>

        <div class="blog-selects">
          <label class="blog-select-label">
            <span class="sr-only">{t("blog.sortLabel")}</span>
            <select class="blog-select" data-js-sort>
              <option value="date-desc">{t("blog.sortNewest")}</option>
              <option value="date-asc">{t("blog.sortOldest")}</option>
              <option value="views-desc">{t("blog.sortPopular")}</option>
            </select>
          </label>
        </div>
      </div>

      <!-- Article cards -->
      <div class="blog-list" data-js-blog-list>
        {
          posts.map((post) => {
            const iso = toIsoDate(post.data.date);
            return (
              <div
                class="blog-list-item"
                data-slug={post.data.slug}
                data-tags={post.data.tags.join(",")}
                data-date={iso}
                data-views="0"
              >
                <FeaturedPost
                  href={postPath(lang, iso, post.data.slug)}
                  title={post.data.title}
                  date={iso}
                  dateLabel={formatPostDate(post.data.date, lang)}
                  summary={post.data.summary}
                  imageUrl={thumbnails.get(post.id)!}
                  imageAlt={post.data.thumbnailAlt ?? post.data.title}
                />
              </div>
            );
          })
        }
      </div>

      <p class="blog-empty color-fg-muted d-none" data-js-blog-empty>
        {t("blog.empty")}
      </p>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  // Client-side filtering/sorting for the blog list. All data lives in the
  // cards' data-* attributes, so this is pure DOM work - no fetch, no framework
  // (matching the project's vanilla-JS convention; scoped to this page only).
  (function () {
    const list = document.querySelector<HTMLElement>("[data-js-blog-list]");
    const tagBar = document.querySelector<HTMLElement>("[data-js-tag-filter]");
    const sortSel = document.querySelector<HTMLSelectElement>("[data-js-sort]");
    const empty = document.querySelector<HTMLElement>("[data-js-blog-empty]");
    if (!list) return;

    const items = Array.from(
      list.querySelectorAll<HTMLElement>(".blog-list-item"),
    );
    // Cumulative tag filter: an empty set means "Visas tēmas" (show all);
    // otherwise a card shows if it carries *any* selected tag (OR gate).
    const activeTags = new Set<string>();

    function apply() {
      let visible = 0;

      items.forEach((el) => {
        const tags = (el.dataset.tags || "").split(",").filter(Boolean);
        const show =
          activeTags.size === 0 ||
          [...activeTags].some((t) => tags.includes(t));
        el.classList.toggle("d-none", !show);
        if (show) visible++;
      });

      empty?.classList.toggle("d-none", visible !== 0);

      // Sort. ISO YYYY-MM-DD compares lexicographically == chronologically;
      // "views-desc" uses the live counts populated below (Phase 2).
      const mode = sortSel?.value || "date-desc";
      const sorted = items.slice().sort((a, b) => {
        if (mode === "views-desc") {
          return Number(b.dataset.views || 0) - Number(a.dataset.views || 0);
        }
        const da = a.dataset.date || "";
        const db = b.dataset.date || "";
        return mode === "date-asc" ? da.localeCompare(db) : db.localeCompare(da);
      });
      // `list` is non-null here (guarded above); the narrowing just doesn't
      // reach into this nested closure.
      sorted.forEach((el) => list!.appendChild(el));
    }

    // Reflect the active set onto the chips. The "Visas tēmas" chip (empty
    // data-tag) lights up only when no specific tags are selected.
    function syncTagButtons() {
      tagBar?.querySelectorAll<HTMLElement>("[data-tag]").forEach((btn) => {
        const tag = btn.dataset.tag || "";
        const on = tag ? activeTags.has(tag) : activeTags.size === 0;
        btn.classList.toggle("active", on);
        btn.classList.toggle("btn-secondary", on);
        btn.classList.toggle("btn-invisible", !on);
        btn.setAttribute("aria-pressed", String(on));
      });
    }

    tagBar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-tag]");
      if (!btn) return;
      const tag = btn.dataset.tag || "";
      // "Visas tēmas" clears everything; a specific tag toggles in/out.
      if (!tag) {
        activeTags.clear();
      } else if (activeTags.has(tag)) {
        activeTags.delete(tag);
      } else {
        activeTags.add(tag);
      }
      syncTagButtons();
      apply();
    });

    sortSel?.addEventListener("change", apply);

    // Phase 2: pull live view counts from the Cloudflare function to enable the
    // "Populārākie" sort. No-ops gracefully when the API isn't deployed.
    fetch("/api/views")
      .then((r) => (r.ok ? r.json() : null))
      .then((counts: Record<string, number> | null) => {
        if (!counts) return;
        items.forEach((el) => {
          const slug = el.dataset.slug;
          if (slug && counts[slug] != null) el.dataset.views = String(counts[slug]);
        });
        if ((sortSel?.value || "") === "views-desc") apply();
      })
      .catch(() => {});

    // Allow deep-linking from an article's tag chips: /blogs?tag=treniņi
    const urlTag = new URLSearchParams(window.location.search).get("tag");
    if (urlTag && items.some((el) => (el.dataset.tags || "").split(",").includes(urlTag))) {
      activeTags.add(urlTag);
    }

    syncTagButtons();
    apply();
  })();
</script>
